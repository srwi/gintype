        <translation locale="en">Debug trace logging</translation>
        </string>
    <string name="gboard_patches_nintype_trace_logging_summary">
        <translation locale="en">Record touch paths, timings, and decoder candidates to local trace logs for troubleshooting.</translation>
        </string>
    <string name="gboard_patches_nintype_trace_export_title">
        <translation locale="en">Export debug trace log…</translation>
        </string>
