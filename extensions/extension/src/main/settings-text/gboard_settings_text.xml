    <string name="gboard_patches_nintype_trace_export_done">
        <translation locale="en">Trace log exported.</translation>
        </string>
    <string name="gboard_patches_nintype_trace_clear_title">
        <translation locale="en">Clear debug trace logs</translation>
        </string>
    <string name="gboard_patches_nintype_trace_clear_summary">
        <translation locale="en">Delete locally stored Nintype trace log files.</translation>
        </string>
    <string name="gboard_patches_nintype_trace_clear_confirm_title">
        <translation locale="en">Clear debug trace logs?</translation>
        </string>
    <string name="gboard_patches_nintype_trace_clear_confirm_message">
        <translation locale="en">Delete all recorded Nintype trace log files?</translation>
        </string>
    <string name="gboard_patches_nintype_trace_clear_done">
        <translation locale="en">Debug trace logs cleared.</translation>
        </string>
    <string name="gboard_patches_nintype_section_reset">
        <translation locale="en">Reset</translation>
        </string>
    <string name="gboard_patches_nintype_reset_title">
        <translation locale="en">Restore default settings</translation>
        </string>
    <string name="gboard_patches_nintype_reset_summary">
        <translation locale="en">Reset Nintype behavior, timing, decoder tuning, and debug logging to release defaults.</translation>
        </string>
    <string name="gboard_patches_nintype_reset_confirm_title">
        <translation locale="en">Restore Nintype defaults?</translation>
        </string>
    <string name="gboard_patches_nintype_reset_confirm_message">
        <translation locale="en">All customized timings and Kinetica decoder tuning values will be reset to their defaults.</translation>
        </string>
    <string name="gboard_patches_nintype_reset_done">
        <translation locale="en">Nintype settings restored to defaults.</translation>
        </string>
