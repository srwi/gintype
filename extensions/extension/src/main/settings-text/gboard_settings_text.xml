    <string name="gboard_patches_nintype_title">
        <translation locale="en">Nintype Multi-Touch Swipe</translation>
        </string>
    <string name="gboard_patches_nintype_summary">
        <translation locale="en">Two-finger swipe and tap+swipe chorded gesture typing powered by the Nintype algorithm.</translation>
        </string>
    <string name="gboard_patches_nintype_section_behavior">
        <translation locale="en">Behavior</translation>
        </string>
    <string name="gboard_patches_nintype_enabled_title">
        <translation locale="en">Enable Nintype two-finger swipe</translation>
        </string>
    <string name="gboard_patches_nintype_enabled_summary">
        <translation locale="en">Automatically takes over when two fingers swipe or combine tap + swipe on the keyboard while keeping single-finger typing and swiping on the stock Gboard engine.</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_title">
        <translation locale="en">Auto-space before/after two-finger words</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_summary">
        <translation locale="en">Automatically insert spaces between words decoded by Nintype two-finger gestures.</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_delay_title">
        <translation locale="en">Auto-space delay</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_delay_summary">
        <translation locale="en">Wait time after lifting all fingers before committing the word and inserting a space.</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_delay_value">
        <translation locale="en">%d ms</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_delay_value_default">
        <translation locale="en">%d ms (Default)</translation>
        </string>
    <string name="gboard_patches_nintype_auto_space_delay_custom">
        <translation locale="en">Custom…</translation>
        </string>
    <string name="gboard_patches_nintype_combine_delay_title">
        <translation locale="en">Single-finger combine timeout</translation>
        </string>
    <string name="gboard_patches_nintype_combine_delay_summary">
        <translation locale="en">If a second swipe or tap follows a stock Gboard swipe/tap within this window, retroactively combine both in Nintype (0 = off).</translation>
        </string>
    <string name="gboard_patches_nintype_combine_delay_off">
        <translation locale="en">0 ms (Off)</translation>
        </string>
    <string name="gboard_patches_nintype_section_tuning">
        <translation locale="en">Decoder tuning</translation>
        </string>
    <string name="gboard_patches_nintype_beam_width_title">
        <translation locale="en">Beam width</translation>
        </string>
    <string name="gboard_patches_nintype_beam_width_summary">
        <translation locale="en">Maximum prefixes kept per letter in parallel two-thumb swipes (higher = better recall on large dictionaries, slightly more CPU).</translation>
        </string>
    <string name="gboard_patches_nintype_freq_weight_floor_title">
        <translation locale="en">Frequency weight floor</translation>
        </string>
    <string name="gboard_patches_nintype_freq_weight_floor_summary">
        <translation locale="en">Minimum score factor for rare words (lower = favor common words, higher = favor exact path match).</translation>
        </string>
    <string name="gboard_patches_nintype_geo_exponent_title">
        <translation locale="en">Geometry exponent</translation>
        </string>
    <string name="gboard_patches_nintype_geo_exponent_summary">
        <translation locale="en">Sensitivity to swipe shape error (higher = prioritize exact geometric match over word frequency/bigrams).</translation>
        </string>
    <string name="gboard_patches_nintype_beam_freq_weight_title">
        <translation locale="en">Beam frequency weight</translation>
        </string>
    <string name="gboard_patches_nintype_beam_freq_weight_summary">
        <translation locale="en">Bias toward frequent word prefixes while pruning the beam search (0 = pure geometry, higher = keep common words).</translation>
        </string>
    <string name="gboard_patches_nintype_value_default">
        <translation locale="en">%s (Default)</translation>
        </string>
